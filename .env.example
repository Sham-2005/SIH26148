# SIH26148 - JOCKY Framework Environment Configuration

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=dev_secret_key_change_in_production_jocky_2026

# Database
# Default fallback to SQLite in development, PostgreSQL in staging/production
DATABASE_URL=sqlite:///./jocky_forensics.db
# DATABASE_URL=postgresql://jocky_user:jocky_password@localhost:5432/jocky_db

# Security & Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Central Management Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Forensic Agent Settings
AGENT_REGISTRATION_TOKEN=jocky-agent-enrollment-secret-2026
AGENT_HEARTBEAT_INTERVAL=15
EVIDENCE_STORAGE_DIR=./evidence_storage
REPORTS_STORAGE_DIR=./reports_output
