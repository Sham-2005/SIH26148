// JOCKY Grammar Definition for Lark LALR/Earley parser

start: program

program: script_decl*

script_decl: "script" CNAME "{" statement* "}"

statement: var_decl
         | assignment
         | expr_stmt
         | if_stmt
         | for_stmt

var_decl: CNAME "=" expr ";"
assignment: CNAME "=" expr ";"
expr_stmt: expr ";"

if_stmt: "if" expr "{" statement* "}" ["else" "{" statement* "}"]
for_stmt: "for" CNAME "in" expr "{" statement* "}"

expr: function_call
    | literal
    | CNAME
    | binary_op

binary_op: expr OPERATOR expr

function_call: CNAME "." CNAME "(" [arg_list] ")"

arg_list: expr ("," expr)*

literal: ESCAPED_STRING   -> string_lit
       | SIGNED_NUMBER    -> number_lit
       | "true"           -> bool_true
       | "false"          -> bool_false

OPERATOR: "==" | "!=" | "<=" | ">=" | "<" | ">" | "+" | "-" | "*" | "/"

COMMENT: "//" /[^\n]/*

%import common.CNAME
%import common.ESCAPED_STRING
%import common.SIGNED_NUMBER
%import common.WS

%ignore WS
%ignore COMMENT
